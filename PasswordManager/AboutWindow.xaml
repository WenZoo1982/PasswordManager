<Window x:Class="PasswordManager.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="关于"
        Width="560"
        Height="700"
        MinWidth="480"
        MinHeight="550"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen">

    <Grid Background="#F5F6F8">

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

            <Border Width="480"
                    MaxWidth="650"
                    Margin="20"
                    Padding="30"
                    Background="White"
                    CornerRadius="10"
                    HorizontalAlignment="Center">

                <StackPanel>

                    <!-- 软件名称 -->

                    <TextBlock Text="本地密码管理器"
                               FontSize="24"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"/>

                    <!-- 软件版本 -->

                    <TextBlock x:Name="VersionText"
                               Text="版本 1.01.0"
                               FontSize="14"
                               Foreground="#777777"
                               HorizontalAlignment="Center"
                               Margin="0,8,0,24"/>

                    <!-- 软件简介 -->

                    <TextBlock Text="一款运行在本地 Windows 电脑上的密码管理工具。"
                               FontSize="14"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,6"/>

                    <TextBlock Text="密码数据保存在你自己选择的密码库文件中，软件不依赖服务器运行。"
                               FontSize="14"
                               Foreground="#777777"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,24"/>

                    <Separator Margin="0,0,0,20"/>


                    <!-- 密码库位置 -->

                    <TextBlock Text="密码库位置"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8"/>

                    <TextBox x:Name="VaultPathText"
                             MinHeight="60"
                             Padding="10"
                             IsReadOnly="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"/>


                    <!-- 配置文件位置 -->

                    <TextBlock Text="配置文件位置"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Margin="0,18,0,8"/>

                    <TextBox x:Name="ConfigPathText"
                             MinHeight="60"
                             Padding="10"
                             IsReadOnly="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"/>


                    <!-- 重要提醒 -->

                    <Border Background="#FFF8E1"
                            BorderBrush="#F0D98C"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12"
                            Margin="0,20,0,0">

                        <StackPanel>

                            <TextBlock Text="重要提醒"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="#6B5700"
                                       Margin="0,0,0,6"/>

                            <TextBlock Text="密码库文件、config.json 以及主密码都很重要，请妥善保存。"
                                       FontSize="13"
                                       Foreground="#6B5700"
                                       TextWrapping="Wrap"/>

                            <TextBlock Text="密码库文件丢失、损坏或主密码遗忘，可能导致密码数据无法恢复。"
                                       FontSize="13"
                                       Foreground="#6B5700"
                                       TextWrapping="Wrap"
                                       Margin="0,6,0,0"/>

                        </StackPanel>

                    </Border>


                    <!-- 免责声明 -->

                    <TextBlock Text="免责声明"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Margin="0,24,0,10"/>

                    <Border Background="#F8F9FA"
                            BorderBrush="#E5E7EB"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12">

                        <TextBlock Text="本软件为个人本地密码管理工具，仅用于帮助用户保存和管理个人账号信息。密码数据由用户自行保管，软件作者不会获取或保存用户的主密码及密码库内容。&#10;&#10;用户应自行妥善保管密码库文件、config.json 以及主密码，并承担因文件丢失、损坏、误删除、主密码遗忘或其他不可预见原因造成的数据损失风险。&#10;&#10;本软件按现有功能提供，不保证在所有硬件、操作系统或使用环境下均不存在程序错误。使用本软件即表示用户理解并接受上述风险。"
                                   FontSize="13"
                                   Foreground="#555555"
                                   TextWrapping="Wrap"/>

                    </Border>


                    <!-- 作者 -->

                    <TextBlock Text="作者：WenZoo"
                               FontSize="13"
                               Foreground="#777777"
                               HorizontalAlignment="Center"
                               Margin="0,20,0,0"/>


                    <!-- 关闭 -->

                    <Button Content="关闭"
                            Width="90"
                            Height="38"
                            HorizontalAlignment="Center"
                            Margin="0,20,0,0"
                            Click="CloseButton_Click"/>

                </StackPanel>

            </Border>

        </ScrollViewer>

    </Grid>

</Window>