<Window x:Class="PasswordManager.ChangePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="修改主密码"
        Width="460"
        Height="480"
        MinWidth="400"
        MinHeight="430"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen">

    <Grid Background="#F5F6F8">

        <Border Width="380"
                MaxWidth="600"
                Margin="20"
                Padding="30"
                Background="White"
                CornerRadius="10"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <StackPanel>

                <TextBlock Text="修改主密码"
                           FontSize="22"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,24"/>

                <TextBlock Text="当前主密码"
                           FontSize="14"
                           Margin="0,0,0,8"/>

                <PasswordBox x:Name="CurrentPasswordBox"
                             Height="38"
                             FontSize="15"
                             Padding="10,0"
                             VerticalContentAlignment="Center"/>

                <TextBlock Text="新主密码"
                           FontSize="14"
                           Margin="0,18,0,8"/>

                <PasswordBox x:Name="NewPasswordBox"
                             Height="38"
                             FontSize="15"
                             Padding="10,0"
                             VerticalContentAlignment="Center"/>

                <TextBlock Text="确认新主密码"
                           FontSize="14"
                           Margin="0,18,0,8"/>

                <PasswordBox x:Name="ConfirmPasswordBox"
                             Height="38"
                             FontSize="15"
                             Padding="10,0"
                             VerticalContentAlignment="Center"/>

                <Grid Margin="0,24,0,0">

                    <Button Content="取消"
                            Width="90"
                            Height="38"
                            HorizontalAlignment="Left"
                            Click="CancelButton_Click"/>

                    <Button Content="修改"
                            Width="90"
                            Height="38"
                            HorizontalAlignment="Right"
                            Click="ChangeButton_Click"/>

                </Grid>

                <TextBlock x:Name="ErrorText"
                           Text=""
                           Foreground="#D93025"
                           HorizontalAlignment="Center"
                           Margin="0,12,0,0"
                           TextWrapping="Wrap"/>

            </StackPanel>

        </Border>

    </Grid>

</Window>
