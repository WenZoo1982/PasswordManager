<Window x:Class="PasswordManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="本地密码管理器"
        Width="1000"
        Height="650"
        MinWidth="760"
        MinHeight="500"
        WindowStartupLocation="CenterScreen">

    <Grid Background="#F5F6F8">

        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <!-- 顶部栏 -->

        <Border Grid.Row="0"
                Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="0,0,0,1">

            <Grid Margin="24,0">

                <TextBlock Text="本地密码管理器"
                           VerticalAlignment="Center"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="#202124"/>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">

                    <Button Content="关于"
                            Width="72"
                            Height="34"
                            Margin="0,0,10,0"
                            Click="AboutButton_Click"/>

                    <Button Content="修改主密码"
                            Width="110"
                            Height="34"
                            Margin="0,0,10,0"
                            Click="ChangePasswordButton_Click"/>

                    <Button Content="迁移密码库"
                            Width="110"
                            Height="34"
                            Margin="0,0,10,0"
                            Click="MigrateVaultButton_Click"/>

                    <Button Content="锁定"
                            Width="72"
                            Height="34"
                            Click="LockButton_Click"/>

                </StackPanel>

            </Grid>

        </Border>


        <!-- 主内容 -->

        <Grid Grid.Row="1"
              Margin="24">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>


            <!-- 左侧 -->

            <Border Grid.Column="0"
                    Background="White"
                    CornerRadius="8"
                    Padding="16">

                <StackPanel>

                    <TextBlock Text="密码库"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Margin="0,0,0,16"/>

                    <Button Content="全部密码"
                            Height="40"
                            HorizontalContentAlignment="Left"
                            Padding="12,0"/>

                </StackPanel>

            </Border>


            <!-- 右侧 -->

            <Border Grid.Column="2"
                    Background="White"
                    CornerRadius="8"
                    Padding="20">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="76"/>
                        <RowDefinition Height="50"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>


                    <!-- 标题 -->

                    <Grid Grid.Row="0">

                        <StackPanel VerticalAlignment="Center">

                            <TextBlock Text="我的密码"
                                       FontSize="20"
                                       FontWeight="SemiBold"/>

                            <TextBlock x:Name="VaultPathText"
                                       FontSize="12"
                                       Foreground="#888888"
                                       Margin="0,4,0,0"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="ConfigPathText"
                                       FontSize="12"
                                       Foreground="#888888"
                                       Margin="0,2,0,0"
                                       TextTrimming="CharacterEllipsis"/>

                        </StackPanel>

                        <Button Content="+ 添加密码"
                                Width="110"
                                Height="36"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Click="AddPasswordButton_Click"/>

                    </Grid>


                    <!-- 搜索 -->

                    <Grid Grid.Row="1"
                          Margin="0,4,0,8">

                        <TextBox x:Name="SearchBox"
                                 Height="36"
                                 VerticalContentAlignment="Center"
                                 Padding="12,0"
                                 FontSize="14"
                                 TextChanged="SearchBox_TextChanged"
                                 GotFocus="SearchBox_GotFocus"
                                 LostFocus="SearchBox_LostFocus"/>

                        <TextBlock x:Name="SearchPlaceholder"
                                   Text="搜索密码..."
                                   Margin="12,0"
                                   VerticalAlignment="Center"
                                   Foreground="#999999"
                                   IsHitTestVisible="False"/>

                    </Grid>


                    <!-- 密码列表 -->

                    <ListBox x:Name="PasswordList"
                             Grid.Row="2"
                             BorderThickness="0"
                             Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="PasswordList_SelectionChanged">

                        <ListBox.ItemTemplate>

                            <DataTemplate>

                                <Border Background="#F8F9FA"
                                        CornerRadius="8"
                                        Padding="16"
                                        Margin="0,0,0,8">

                                    <Grid>

                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0"
                                                   Text="{Binding Title}"
                                                   FontSize="16"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"/>

                                        <TextBlock Grid.Row="1"
                                                   Text="{Binding Username}"
                                                   FontSize="14"
                                                   Foreground="#777777"
                                                   Margin="0,6,0,0"
                                                   TextTrimming="CharacterEllipsis"/>

                                    </Grid>

                                </Border>

                            </DataTemplate>

                        </ListBox.ItemTemplate>

                    </ListBox>

                </Grid>

            </Border>

        </Grid>

    </Grid>

</Window>