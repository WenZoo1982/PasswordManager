<Window x:Class="PasswordManager.PasswordDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="密码详情"
        Width="560"
        Height="740"
        MinWidth="440"
        MinHeight="520"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen">

    <Grid Background="#F5F6F8">

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

            <Border Width="480"
                    MaxWidth="650"
                    Margin="20"
                    Padding="30"
                    Background="White"
                    CornerRadius="10"
                    HorizontalAlignment="Center">

                <StackPanel>

                    <TextBlock x:Name="TitleText"
                               Text="密码详情"
                               FontSize="22"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,24"/>

                    <TextBlock Text="网站名称 / 应用名称"
                               FontSize="14"
                               Margin="0,0,0,8"/>

                    <TextBox x:Name="TitleBox"
                             Height="38"
                             Padding="10,0"
                             VerticalContentAlignment="Center"
                             IsReadOnly="True"/>

                    <TextBlock Text="网址"
                               FontSize="14"
                               Margin="0,18,0,8"/>

                    <Grid>

                        <TextBox x:Name="UrlBox"
                                 Height="38"
                                 Padding="10,0"
                                 VerticalContentAlignment="Center"
                                 IsReadOnly="True"
                                 Margin="0,0,75,0"/>

                        <Button x:Name="OpenUrlButton"
                                Content="打开"
                                Width="65"
                                Height="32"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Click="OpenUrlButton_Click"/>

                    </Grid>

                    <TextBlock Text="用户名"
                               FontSize="14"
                               Margin="0,18,0,8"/>

                    <Grid>

                        <TextBox x:Name="UsernameBox"
                                 Height="38"
                                 Padding="10,0"
                                 VerticalContentAlignment="Center"
                                 IsReadOnly="True"
                                 Margin="0,0,75,0"/>

                        <Button x:Name="CopyUsernameButton"
                                Content="复制"
                                Width="65"
                                Height="32"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Click="CopyUsernameButton_Click"/>

                    </Grid>

                    <TextBlock Text="密码"
                               FontSize="14"
                               Margin="0,18,0,8"/>

                    <Grid>

                        <PasswordBox x:Name="PasswordBox"
                                     Height="38"
                                     Padding="10,0"
                                     VerticalContentAlignment="Center"
                                     Margin="0,0,145,0"
                                     IsHitTestVisible="False"/>

                        <TextBox x:Name="VisiblePasswordBox"
                                 Height="38"
                                 Padding="10,0"
                                 VerticalContentAlignment="Center"
                                 Margin="0,0,145,0"
                                 Visibility="Collapsed"
                                 IsReadOnly="True"/>

                        <Button x:Name="ShowPasswordButton"
                                Content="显示"
                                Width="65"
                                Height="32"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Margin="0,0,70,0"
                                Click="ShowPasswordButton_Click"/>

                        <Button x:Name="CopyPasswordButton"
                                Content="复制"
                                Width="65"
                                Height="32"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Click="CopyPasswordButton_Click"/>

                    </Grid>

                    <TextBlock Text="备注"
                               FontSize="14"
                               Margin="0,18,0,8"/>

                    <TextBox x:Name="NotesBox"
                             Height="70"
                             Padding="10,8"
                             VerticalContentAlignment="Top"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             IsReadOnly="True"/>

                    <Grid Margin="0,22,0,0">

                        <Button x:Name="DeleteButton"
                                Content="删除"
                                Width="90"
                                Height="38"
                                HorizontalAlignment="Left"
                                Click="DeleteButton_Click"/>

                        <Button x:Name="EditButton"
                                Content="编辑"
                                Width="90"
                                Height="38"
                                HorizontalAlignment="Center"
                                Click="EditButton_Click"/>

                        <Button x:Name="CloseButton"
                                Content="关闭"
                                Width="90"
                                Height="38"
                                HorizontalAlignment="Right"
                                Click="CloseButton_Click"/>

                    </Grid>

                </StackPanel>

            </Border>

        </ScrollViewer>

    </Grid>

</Window>

