<Window x:Class="PasswordManager.CreateVaultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="密码库"
        Width="520"
        Height="430"
        MinWidth="440"
        MinHeight="390"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen">

    <Grid Background="#F5F6F8">

        <Border Width="440"
                MaxWidth="600"
                Margin="20"
                Padding="30"
                Background="White"
                CornerRadius="10"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <StackPanel>

                <TextBlock Text="密码库"
                           FontSize="22"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,8"/>

                <TextBlock Text="选择已有密码库，或创建一个新的密码库"
                           FontSize="14"
                           Foreground="#777777"
                           HorizontalAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0,0,0,24"/>

                <Button Content="选择已有密码库"
                        Height="40"
                        FontSize="15"
                        Click="OpenExistingButton_Click"/>

                <TextBlock Text="或者创建新的密码库"
                           FontSize="13"
                           Foreground="#999999"
                           HorizontalAlignment="Center"
                           Margin="0,20,0,16"/>

                <TextBlock Text="新密码库保存位置"
                           FontSize="14"
                           Margin="0,0,0,8"/>

                <Grid>

                    <TextBox x:Name="FilePathBox"
                             Height="38"
                             Padding="10,0"
                             VerticalContentAlignment="Center"
                             Margin="0,0,78,0"
                             Text="请选择路径"
                             IsReadOnly="True"/>

                    <Button Content="浏览"
                            Width="70"
                            Height="30"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,4,0"
                            Click="ChooseFileButton_Click"/>

                </Grid>

                <Button Content="创建密码库"
                        Height="40"
                        Margin="0,20,0,0"
                        FontSize="15"
                        Click="CreateButton_Click"/>

                <TextBlock x:Name="ErrorText"
                           Text=""
                           Foreground="#D93025"
                           HorizontalAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0,12,0,0"/>

            </StackPanel>

        </Border>

    </Grid>

</Window>