<Window x:Class="PasswordManager.CreatePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置主密码"
        Width="460"
        Height="420"
        MinWidth="400"
        MinHeight="360"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen">

    <Grid Background="#F5F6F8">

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

            <Border Width="380"
                    MaxWidth="600"
                    Margin="20"
                    Padding="30"
                    Background="White"
                    CornerRadius="10"
                    HorizontalAlignment="Center">

                <StackPanel>

                    <TextBlock Text="设置主密码"
                               FontSize="22"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,8"/>

                    <TextBlock Text="主密码用于解锁你的密码库，请牢记它。"
                               FontSize="14"
                               Foreground="#777777"
                               HorizontalAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="0,0,0,24"/>

                    <TextBlock Text="主密码"
                               FontSize="14"
                               Margin="0,0,0,8"/>

                    <PasswordBox x:Name="PasswordBox"
                                 Height="38"
                                 FontSize="15"
                                 Padding="10,0"
                                 VerticalContentAlignment="Center"/>

                    <TextBlock Text="确认主密码"
                               FontSize="14"
                               Margin="0,18,0,8"/>

                    <PasswordBox x:Name="ConfirmPasswordBox"
                                 Height="38"
                                 FontSize="15"
                                 Padding="10,0"
                                 VerticalContentAlignment="Center"/>

                    <Button Content="创建密码库"
                            Height="40"
                            Margin="0,22,0,0"
                            FontSize="15"
                            Click="CreateButton_Click"/>

                    <TextBlock x:Name="ErrorText"
                               Text=""
                               Foreground="#D93025"
                               HorizontalAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="0,10,0,0"/>

                </StackPanel>

            </Border>

        </ScrollViewer>

    </Grid>

</Window>