<Window x:Class="PasswordManager.AddPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="添加密码"
        Width="560"
        Height="720"
        MinWidth="440"
        MinHeight="500"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen">

    <Grid Background="#F5F6F8">

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

            <Border Width="440"
                    MaxWidth="600"
                    Margin="20"
                    Padding="30"
                    Background="White"
                    CornerRadius="10"
                    HorizontalAlignment="Center">

                <StackPanel>

                    <TextBlock Text="添加密码"
                               FontSize="22"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,24"/>

                    <TextBlock Text="网站名称 / 应用名称"
                               FontSize="14"
                               Margin="0,0,0,8"/>

                    <TextBox x:Name="TitleBox"
                             Height="38"
                             Padding="10,0"
                             VerticalContentAlignment="Center"/>

                    <TextBlock Text="网址"
                               FontSize="14"
                               Margin="0,18,0,8"/>

                    <TextBox x:Name="UrlBox"
                             Height="38"
                             Padding="10,0"
                             VerticalContentAlignment="Center"/>

                    <TextBlock Text="用户名"
                               FontSize="14"
                               Margin="0,18,0,8"/>

                    <TextBox x:Name="UsernameBox"
                             Height="38"
                             Padding="10,0"
                             VerticalContentAlignment="Center"/>

                    <TextBlock Text="密码"
                               FontSize="14"
                               Margin="0,18,0,8"/>

                    <Grid>

                        <PasswordBox x:Name="PasswordBox"
                                     Height="38"
                                     Padding="10,0"
                                     VerticalContentAlignment="Center"
                                     Margin="0,0,75,0"/>

                        <TextBox x:Name="VisiblePasswordBox"
                                 Height="38"
                                 Padding="10,0"
                                 VerticalContentAlignment="Center"
                                 Margin="0,0,75,0"
                                 Visibility="Collapsed"/>

                        <Button x:Name="ShowPasswordButton"
                                Content="显示"
                                Width="65"
                                Height="32"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Click="ShowPasswordButton_Click"/>

                    </Grid>

                    <TextBlock Text="备注"
                               FontSize="14"
                               Margin="0,18,0,8"/>

                    <TextBox x:Name="NotesBox"
                             Height="70"
                             Padding="10,8"
                             VerticalContentAlignment="Top"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"/>

                    <Grid Margin="0,22,0,0">

                        <Button Content="取消"
                                Width="90"
                                Height="38"
                                HorizontalAlignment="Left"
                                Click="CancelButton_Click"/>

                        <Button Content="保存"
                                Width="90"
                                Height="38"
                                HorizontalAlignment="Right"
                                Click="SaveButton_Click"/>

                    </Grid>

                </StackPanel>

            </Border>

        </ScrollViewer>

    </Grid>

</Window>
