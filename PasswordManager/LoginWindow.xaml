 <Window x:Class="PasswordManager.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="解锁密码库"
        Width="420"
        Height="340"
        MinWidth="360"
        MinHeight="280"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen">

    <Grid Background="#F5F6F8">

        <Border Width="340"
                MaxWidth="500"
                Margin="20"
                Padding="30"
                Background="White"
                CornerRadius="10"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <StackPanel>

                <TextBlock Text="本地密码管理器"
                           FontSize="22"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,8"/>

                <TextBlock Text="请输入主密码解锁密码库"
                           FontSize="14"
                           Foreground="#777777"
                           HorizontalAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0,0,0,24"/>

                <PasswordBox x:Name="PasswordBox"
                             Height="38"
                             FontSize="15"
                             Padding="10,0"
                             VerticalContentAlignment="Center"
                             KeyDown="PasswordBox_KeyDown"/>

                <Button Content="解锁"
                        Height="38"
                        Margin="0,20,0,0"
                        FontSize="15"
                        Click="UnlockButton_Click"/>

                <TextBlock x:Name="ErrorText"
                           Text=""
                           Foreground="#D93025"
                           HorizontalAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0,12,0,0"/>

            </StackPanel>

        </Border>

    </Grid>

</Window>
